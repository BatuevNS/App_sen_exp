    <Routine name="start_exp"/>
    <LoopTerminator name="trials_33"/>
    <LoopInitiator loopType="TrialHandler" name="trials_26">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'sen_exp': 'Завтрак удался, потому что нити были липкими\xa0\xa0\xa0\xa0', 'ans_exp': 'паутина'}, {'sen_exp': 'Стояла полная тишина, потому что палочка не двигалась', 'ans_exp': 'дирижёр'}, {'sen_exp': 'Стрелки были неровные, потому что доска сломалась', 'ans_exp': 'глажка'}, {'sen_exp': 'Спортсмен пропустил приём, потому что метил в другую категорию', 'ans_exp': 'пищи'}, {'sen_exp': 'Новый год прошёл без курантов, потому что упала тарелка\xa0', 'ans_exp': 'спутниковая'}, {'sen_exp': 'Сон был прерван, потому что жира было недостаточно', 'ans_exp': 'медведь'}, {'sen_exp': 'Чемпион олимпиады по теннису отказался от интервью, потому что не преодолел барьер', 'ans_exp': 'языковой'}, {'sen_exp': 'Медведица помогла вернуться на берег, потому что электроника сломалась', 'ans_exp': 'созвездие'}, {'sen_exp': 'Мужчина понял, что магазин пустой, потому что очередь была длинной', 'ans_exp': 'автоматная'}, {'sen_exp': 'В зале было шумно, потому что молоток сломался', 'ans_exp': 'судья'}, {'sen_exp': 'Преподаватель был недоволен, потому что ученик не смог взять соль', 'ans_exp': 'нота'}, {'sen_exp': 'Свист прекратился, потому что огонь погасили', 'ans_exp': 'чайник'}, {'sen_exp': 'Люди вернулись домой ни с чем, потому что шляпки были очень маленькими', 'ans_exp': 'грибы'}, {'sen_exp': 'Малыш был в сумке, потому что было пора подкрепиться', 'ans_exp': 'кенгуру'}, {'sen_exp': 'Корабль потерялся, потому что свет погас', 'ans_exp': 'маяк'}, {'sen_exp': 'Бинты порвались, потому что работники музея были неаккуратны', 'ans_exp': 'мумия'}, {'sen_exp': 'Пробка увеличивалась, потому что гигиена была нарушена', 'ans_exp': 'ухо'}, {'sen_exp': 'Мужчина натёр нос кремом, потому что кожа была новой', 'ans_exp': 'ботинок'}, {'sen_exp': 'Зрители громко хлопали, потому что корзина была далеко', 'ans_exp': 'баскетбол'}, {'sen_exp': 'Цвета стали видны, потому что дождь закончился', 'ans_exp': 'радуга'}, {'sen_exp': 'Бабочка была на полу, потому что узел развязался', 'ans_exp': 'галстук'}, {'sen_exp': 'Мужчина постоянно вертелся, потому что зеркало было сломано', 'ans_exp': 'боковое'}, {'sen_exp': 'Батареи были бесполезны, потому что небо затянуло тучами', 'ans_exp': 'солнечные'}, {'sen_exp': 'Люди поднимались вверх, потому что мешки сбросили', 'ans_exp': 'балласт'}, {'sen_exp': 'Холодильник был полон, потому что преступлений было много', 'ans_exp': 'в морге'}, {'sen_exp': 'У путешественника была карта, поэтому он купил много сувениров', 'ans_exp': 'кредитка'}, {'sen_exp': 'Музыка не играла, потому что иголка потерялась\xa0', 'ans_exp': 'проигрыватель'}, {'sen_exp': 'Свет погас, потому что звонков было три', 'ans_exp': 'театр'}, {'sen_exp': 'Сотрудница не могла найти нужный документ, потому что закрыла окно', 'ans_exp': 'на компьютере'}, {'sen_exp': 'Пачка не пригодилась, потому что представление отменили', 'ans_exp': 'балетная'}, {'sen_exp': 'Курьер встал посреди дороги, потому что коробка сломалась', 'ans_exp': 'передач'}, {'sen_exp': 'Пол был в воде, потому что шланг машины лопнул', 'ans_exp': 'стирка'}, {'sen_exp': 'Художник выбрал кисть побольше, потому что хотел есть', 'ans_exp': 'виноград'}, {'sen_exp': 'Люди испугались, потому что увидели раскраску', 'ans_exp': 'боевую'}, {'sen_exp': 'Стог сена был важен, потому что ткань порвалась', 'ans_exp': 'парашют'}, {'sen_exp': 'Рыбак не знал, какая будет погода, потому что у него пропала сеть', 'ans_exp': 'на смартфоне'}, {'sen_exp': 'Свет мерцал, потому что патрон был старый', 'ans_exp': 'лампочка'}, {'sen_exp': 'Девушка не смогла застегнуть куртку, потому что собачка потерялась', 'ans_exp': 'молния'}, {'sen_exp': 'Люди развели панику, потому что увидели новый столб', 'ans_exp': 'дым'}, {'sen_exp': 'Мужчина заплатил штраф, потому что не заметил кирпич', 'ans_exp': 'дорожный знак'}, {'sen_exp': 'Ребёнок обернулся, потому что его домашний питомец заговорил', 'ans_exp': 'попугай'}, {'sen_exp': 'В офисе было прохладно, потому что все окна были закрыты', 'ans_exp'